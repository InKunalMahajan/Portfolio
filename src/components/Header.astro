---
const links = [{href:'/',label:'Home'},{href:'/about',label:'About'},{href:'/skills',label:'Skills'},{href:'/experience',label:'Experience'},{href:'/projects',label:'Projects'},{href:'/curriculum',label:'Curriculum'},{href:'/resume',label:'Resume'},{href:'/contact',label:'Contact'}];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const url = (path: string) => base + (path === '/' ? '/' : path);
---
<header class="relative z-50 border-b border-white/10 bg-ink/95">
  <div class="container-site flex items-center justify-between gap-4 py-5">
    <a href={url('/')} class="font-black text-xl tracking-tight" aria-label="Kunal Mahajan, home">KM<span class="text-violet">.</span></a>
    <nav aria-label="Primary navigation" class="hidden lg:flex flex-wrap gap-x-4 gap-y-2 text-sm text-white/70">
      {links.map(link => <a class="hover:text-white transition-colors" aria-current={Astro.url.pathname.replace(/\/$/,'') === url(link.href).replace(/\/$/,'') ? 'page' : undefined} href={url(link.href)}>{link.label}</a>)}
    </nav>
    <button id="menu-toggle" type="button" class="lg:hidden rounded-xl border border-white/25 px-4 py-2 text-sm font-semibold" aria-controls="mobile-menu" aria-expanded="false">Menu <span aria-hidden="true">☰</span></button>
  </div>
  <nav id="mobile-menu" aria-label="Mobile navigation" class="hidden lg:hidden border-t border-white/10 container-site py-4" hidden>
    <ul class="grid grid-cols-2 gap-2">{links.map(link => <li><a class="block rounded-xl p-3 text-white/80 hover:bg-white/10" href={url(link.href)}>{link.label}</a></li>)}</ul>
  </nav>
</header>
<script>
const toggle = document.querySelector<HTMLButtonElement>('#menu-toggle');
const menu = document.querySelector<HTMLElement>('#mobile-menu');
if (toggle && menu) {
  const close = () => { toggle.setAttribute('aria-expanded','false'); menu.hidden = true; menu.classList.add('hidden'); };
  toggle.addEventListener('click', () => {
    const opening = toggle.getAttribute('aria-expanded') !== 'true';
    toggle.setAttribute('aria-expanded',String(opening));
    menu.hidden = !opening;
    menu.classList.toggle('hidden', !opening);
  });
  document.addEventListener('keydown', event => { if (event.key === 'Escape') { close(); toggle.focus(); } });
  document.addEventListener('click', event => { if (!menu.contains(event.target as Node) && !toggle.contains(event.target as Node)) close(); });
  window.matchMedia('(min-width: 1024px)').addEventListener('change', event => { if(event.matches) close(); });
}
</script>
