---
const links = [{href:'/',label:'Home'},{href:'/about',label:'About'},{href:'/skills',label:'Skills'},{href:'/experience',label:'Experience'},{href:'/projects',label:'Projects'},{href:'/curriculum',label:'Curriculum'},{href:'/resume',label:'Resume'},{href:'/contact',label:'Contact'}];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const url = (path: string) => base + (path === '/' ? '/' : path);
---
<header class="border-b border-white/10"><div class="container-site flex flex-wrap items-center justify-between gap-4 py-5"><a href={url('/')} class="font-black text-xl tracking-tight">KM<span class="text-violet">.</span></a><nav aria-label="Main navigation" class="flex flex-wrap gap-x-4 gap-y-2 text-xs sm:text-sm text-white/70">{links.map(link => <a class="hover:text-white transition-colors" aria-current={Astro.url.pathname === url(link.href) ? 'page' : undefined} href={url(link.href)}>{link.label}</a>)}</nav></div></header>
