---
import BaseLayout from '../layouts/BaseLayout.astro';
import {site} from '../data/site';
---
<BaseLayout title="About"><section class="container-site py-24 max-w-4xl"><p class="eyebrow">My story</p><h1 class="text-5xl md:text-7xl font-black mt-5 gradient-text">About me.</h1><p class="text-xl text-white/70 leading-relaxed mt-9">I'm Kunal Mahajan, a developer and Deaf educator based in Pune. I bring together software engineering, accessible education, and practical curriculum design.</p><p class="text-white/65 leading-relaxed mt-6">As an Assistant Lecturer in Skills at TEACH, I teach digital skills and information technology through visual, accessible activities. I hold a Diploma in Computer Engineering.</p><p class="text-white/65 leading-relaxed mt-6">My goal is to develop inclusive curricula and research-informed learning experiences. Projects such as SignGyaan and ICOT explore independent learning, everyday skills, measurable outcomes and ISL-first accessibility.</p><div class="grid sm:grid-cols-2 gap-4 mt-10"><div class="glass rounded-2xl p-6"><h2 class="text-lg font-bold">What I value</h2><p class="text-white/60 mt-3">Accessibility, practical learning, clear communication and thoughtful software design.</p></div><div class="glass rounded-2xl p-6"><h2 class="text-lg font-bold">What I'm building</h2><p class="text-white/60 mt-3">Digital tools and curriculum pathways that support more independent learning.</p></div></div><a class="inline-block mt-8 text-violet font-bold" href={site.linkedin} target="_blank" rel="noopener noreferrer">Connect on LinkedIn ↗</a></section></BaseLayout>
