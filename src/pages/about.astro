---
import BaseLayout from '../layouts/BaseLayout.astro';
import {site} from '../data/site';
---
<BaseLayout title="About"><section class="container-site py-24 max-w-4xl"><p class="eyebrow">My story</p><h1 class="text-5xl md:text-7xl font-black mt-5 gradient-text">About me.</h1><p class="text-xl text-white/70 leading-relaxed mt-9">I'm Kunal Mahajan, a developer and Deaf educator based in Pune. My work brings together software engineering, accessible education, and practical curriculum design.</p><p class="text-white/60 leading-relaxed mt-6">I work as an Assistant Lecturer in Skills at TEACH, supporting accessible learning and practical digital skills. I hold a Diploma in Computer Engineering and am developing my expertise in curriculum development and educational research.</p><p class="text-white/60 leading-relaxed mt-6">I am interested in building systems that support independent learning and inclusive digital experiences. This portfolio is a growing record of my projects, teaching practice and design thinking.</p><a class="inline-block mt-8 text-violet font-bold" href={site.linkedin} target="_blank" rel="noopener noreferrer">Connect on LinkedIn ↗</a></section></BaseLayout>
