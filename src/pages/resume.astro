---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Resume"><section class="container-site py-24 max-w-4xl"><p class="eyebrow">Profile</p><h1 class="text-5xl md:text-7xl font-black mt-5">Resume<span class="text-coral">.</span></h1><p class="text-white/60 mt-8">Assistant Lecturer, digital skills trainer, and software developer with a Diploma in Computer Engineering.</p><div class="glass rounded-3xl p-8 mt-10"><h2 class="text-2xl font-bold">Resume download</h2><p class="text-white/60 mt-3">A reviewed PDF resume will be available here soon. No downloadable document is published yet.</p></div></section></BaseLayout>
