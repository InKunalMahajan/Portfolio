---
import BaseLayout from '../layouts/BaseLayout.astro';
import {site} from '../data/site';
const expertise=['Digital skills instruction','Accessible lesson planning','Curriculum development','Laravel and PHP','MySQL and database design','Git and GitHub','Assessment design'];
---
<BaseLayout title="Resume">
<section class="container-site py-20 max-w-5xl">
<div class="flex flex-wrap justify-between items-start gap-6">
<div><p class="eyebrow">Professional profile</p><h1 class="text-5xl md:text-7xl font-black mt-5">Resume<span class="text-coral">.</span></h1><p class="text-white/60 mt-6">Kunal Mahajan · Pune, India</p></div>
<button type="button" onclick="window.print()" class="print-hide rounded-full border border-white/30 px-6 py-3 hover:border-violet">Print / Save as PDF ↗</button>
</div>
<section class="glass rounded-3xl p-7 md:p-10 mt-10"><h2 class="text-2xl font-bold">Professional summary</h2><p class="text-white/70 mt-4 leading-relaxed">Assistant Lecturer in Skills and Deaf educator with a Diploma in Computer Engineering. I develop accessible digital skills lessons, practical assessments, and curriculum concepts. I also explore software development and education technology to support independent learning.</p></section>
<div class="grid md:grid-cols-2 gap-5 mt-5">
<section class="glass rounded-3xl p-7"><h2 class="text-2xl font-bold">Experience</h2><h3 class="font-semibold mt-5">Assistant Lecturer — Skills</h3><p class="text-violet mt-1">TEACH · Pune</p><p class="text-white/65 mt-3">Teaching information technology and digital skills, creating accessible lessons and supporting classroom assessments.</p><p class="text-white/45 text-sm mt-3">Employment dates to be confirmed before publication.</p></section>
<section class="glass rounded-3xl p-7"><h2 class="text-2xl font-bold">Education</h2><h3 class="font-semibold mt-5">Diploma in Computer Engineering</h3><p class="text-white/65 mt-3">Institution and graduation year to be confirmed.</p></section>
</div>
<section class="glass rounded-3xl p-7 md:p-10 mt-5"><h2 class="text-2xl font-bold">Expertise</h2><ul class="flex flex-wrap gap-3 mt-5">{expertise.map(skill=><li class="border border-white/20 rounded-full px-4 py-2 text-sm">{skill}</li>)}</ul></section>
<p class="mt-8 text-white/60 print-hide">For verified professional details, visit <a class="text-violet underline" href={site.linkedin} target="_blank" rel="noopener noreferrer">my LinkedIn profile</a>. This page can be printed as a PDF; a separately reviewed resume file is not yet available.</p>
</section>
</BaseLayout>
<style is:global>
@media print {
  @page { margin: 15mm; }
  body { background: white !important; color: #111 !important; }
  body::before, header, footer, .print-hide { display: none !important; }
  .glass { background: white !important; color: #111 !important; border: 1px solid #ccc !important; break-inside: avoid; }
  .text-white\/60,.text-white\/65,.text-white\/70,.text-white\/45 { color: #333 !important; }
  .text-violet,.text-coral,.eyebrow { color: #333 !important; }
  section { padding-top: 0 !important; padding-bottom: 0 !important; }
}
</style>
