---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import {site, projects} from '../data/site';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<BaseLayout title="Home"><section class="container-site relative pt-24 pb-24 md:pt-36 md:pb-32 overflow-hidden"><div aria-hidden="true" class="orb absolute right-3 top-20 size-40 md:size-72 rounded-full bg-violet/20 blur-3xl pointer-events-none"></div><p class="eyebrow mb-7">Hello, I'm {site.name} · {site.location}</p><h1 class="relative text-5xl sm:text-7xl lg:text-8xl font-black tracking-[-.06em] leading-[1.05] max-w-5xl">Building digital<br/><span class="gradient-text">experiences</span><br/>for everyone.</h1><p class="mt-8 text-lg md:text-xl text-white/60 max-w-2xl leading-relaxed">{site.headline} I connect technology, education and accessibility through practical work.</p><div class="mt-10 flex flex-wrap gap-4"><a href={`${base}/projects/`} class="rounded-full bg-violet text-ink font-bold px-7 py-4 hover:bg-white transition-colors">Explore my work ↗</a><a href={`${base}/contact/`} class="rounded-full border border-white/30 px-7 py-4 hover:border-violet transition-colors">Get in touch</a></div></section><section class="container-site py-12"><div class="flex items-end justify-between gap-4 mb-8"><div><p class="eyebrow mb-3">Selected work</p><h2 class="text-4xl md:text-5xl font-bold tracking-tight">Projects & ideas<span class="text-coral">.</span></h2></div></div><div class="grid md:grid-cols-2 gap-5">{projects.map(project=><ProjectCard project={project}/>)}</div></section><section class="container-site py-24"><div class="glass rounded-3xl p-8 md:p-14"><p class="eyebrow">Beyond code</p><h2 class="text-3xl md:text-5xl font-bold mt-4 max-w-3xl">Technology is most meaningful when more people can use it.</h2><p class="text-white/60 mt-6 max-w-2xl">My interests include accessible digital learning, ISL-first education, inclusive curriculum design and software engineering.</p><a class="inline-block mt-8 text-violet font-bold" href={`${base}/about/`}>More about me ↗</a></div></section></BaseLayout>
