---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Curriculum"><section class="container-site py-24"><p class="eyebrow">Accessible education</p><h1 class="text-5xl md:text-7xl font-black mt-5">Curriculum<span class="text-violet">.</span></h1><p class="text-white/60 text-xl mt-8 max-w-3xl leading-relaxed">Designing practical learning pathways with measurable outcomes, ISL accessibility, and real-world activities.</p><div class="glass rounded-3xl p-8 mt-12 max-w-3xl"><h2 class="text-2xl font-bold">Integrated Commerce and Technology (ICOT)</h2><p class="text-white/60 mt-4">A competency-based curriculum concept connecting commerce, technology and everyday applications.</p></div></section></BaseLayout>
