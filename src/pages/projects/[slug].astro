---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {projects, type CaseStudy} from '../../data/site';
export function getStaticPaths(){return projects.map(project=>({params:{slug:project.slug},props:{project}}));}
const {project}=Astro.props as {project: CaseStudy};
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
---
<BaseLayout title={project.name} description={project.summary}>
<article class="container-site py-20 max-w-5xl">
<a class="text-violet font-semibold" href={`${base}/projects/`}>← All projects</a>
<div class="mt-14 grid md:grid-cols-[1fr_auto] items-start gap-6">
<div><p class="eyebrow">{project.category} · {project.status}</p><h1 class="text-5xl md:text-7xl font-black mt-5 tracking-tight">{project.name}<span class="text-coral">.</span></h1><p class="text-xl text-white/65 mt-7 leading-relaxed max-w-3xl">{project.summary}</p></div>
<span class="text-7xl font-black text-white/10" aria-hidden="true">{project.number}</span>
</div>
<div class="flex flex-wrap gap-3 mt-8">{project.tags.map(tag=><span class="border border-white/20 rounded-full px-4 py-2 text-sm">{tag}</span>)}</div>
<div class="grid md:grid-cols-2 gap-5 mt-14">
<section class="glass rounded-3xl p-8 reveal"><p class="eyebrow mb-3">01 · The challenge</p><h2 class="text-2xl font-bold">What problem does it address?</h2><p class="text-white/65 mt-4 leading-relaxed">{project.challenge}</p></section>
<section class="glass rounded-3xl p-8 reveal"><p class="eyebrow mb-3">02 · The approach</p><h2 class="text-2xl font-bold">How I'm approaching it</h2><p class="text-white/65 mt-4 leading-relaxed">{project.approach}</p></section>
</div>
<section class="mt-12 reveal"><p class="eyebrow mb-3">03 · Design highlights</p><h2 class="text-3xl font-bold">Key work areas</h2><ul class="grid md:grid-cols-2 gap-4 mt-6">{project.highlights.map(item=><li class="glass rounded-2xl p-5 text-white/75"><span class="text-violet" aria-hidden="true">✦</span> {item}</li>)}</ul></section>
<section class="glass rounded-3xl p-8 mt-12 reveal"><p class="eyebrow mb-3">04 · What's next</p><h2 class="text-3xl font-bold">Next milestones</h2><ul class="mt-5 space-y-3 list-disc pl-5 text-white/70">{project.nextSteps.map(step=><li>{step}</li>)}</ul></section>
<p class="text-white/45 text-sm mt-10">Case studies describe ongoing work and planned features. No unverified performance results or client testimonials are claimed.</p>
</article>
</BaseLayout>
