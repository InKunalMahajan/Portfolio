---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {projects} from '../../data/site';
export function getStaticPaths(){return projects.map(project=>({params:{slug:project.slug},props:{project}}));}
const {project}=Astro.props;
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
---
<BaseLayout title={project.name} description={project.summary}><article class="container-site py-24 max-w-4xl"><a class="text-violet" href={`${base}/projects/`}>← All projects</a><p class="eyebrow mt-12">{project.category}</p><h1 class="text-5xl md:text-7xl font-black mt-5">{project.name}<span class="text-coral">.</span></h1><p class="text-xl text-white/65 mt-8 leading-relaxed">{project.summary}</p><div class="flex flex-wrap gap-3 mt-8">{project.tags.map((tag:string)=><span class="border border-white/20 rounded-full px-4 py-2 text-sm">{tag}</span>)}</div><div class="glass rounded-3xl p-8 mt-12"><h2 class="text-2xl font-bold">Project overview</h2><p class="text-white/60 mt-4">This case study is being prepared. Screenshots, development milestones, and verified results will be added as the project progresses.</p></div></article></BaseLayout>
