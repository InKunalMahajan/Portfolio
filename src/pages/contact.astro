---
import BaseLayout from '../layouts/BaseLayout.astro';
import {site} from '../data/site';
---
<BaseLayout title="Contact"><section class="container-site py-24 max-w-4xl"><p class="eyebrow">Let's connect</p><h1 class="text-5xl md:text-7xl font-black mt-5">Say hello<span class="text-violet">.</span></h1><p class="text-xl text-white/60 mt-8 max-w-2xl">Interested in accessible education, curriculum development, or a software project? Connect with me through GitHub. Text-based communication is welcome.</p><a class="inline-block rounded-full bg-violet text-ink font-bold px-7 py-4 mt-10" href={site.github} target="_blank" rel="noopener noreferrer">Visit my GitHub ↗</a></section></BaseLayout>
