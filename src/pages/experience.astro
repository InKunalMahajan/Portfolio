---
import BaseLayout from '../layouts/BaseLayout.astro';
import {site} from '../data/site';
---
<BaseLayout title="Experience"><section class="container-site py-24"><p class="eyebrow">Professional journey</p><h1 class="text-5xl md:text-7xl font-black mt-5">Experience<span class="text-coral">.</span></h1><div class="max-w-4xl mt-12 space-y-6"><article class="glass rounded-3xl p-8"><p class="eyebrow">TEACH · Pune</p><h2 class="text-3xl font-bold mt-3">Assistant Lecturer — Skills</h2><p class="text-white/65 mt-4 leading-relaxed">Teach information technology and digital skills, prepare accessible practical lessons, assess learner progress, and support classroom learning through visual and ISL-first approaches.</p><ul class="list-disc pl-5 mt-5 text-white/65 space-y-2"><li>Digital skills and information technology teaching</li><li>Lesson plans, worksheets and practical demonstrations</li><li>Assessment and syllabus progress tracking</li><li>Inclusive learning and accessibility practices</li></ul></article><article class="glass rounded-3xl p-8"><p class="eyebrow">Professional direction</p><h2 class="text-2xl font-bold mt-3">Curriculum Development & Educational Research</h2><p class="text-white/65 mt-4">Developing competency-based curriculum concepts and accessible education technology. This is a career development focus, not a claim of a separate employment position.</p></article></div><p class="text-white/50 text-sm mt-8">Exact dates and additional roles will be added after verification. <a class="text-violet underline" href={site.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn profile ↗</a></p></section></BaseLayout>
